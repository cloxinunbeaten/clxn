limit_req_zone $binary_remote_addr zone=cloxin_api:10m rate=10r/s;

server {
    listen 80;
    listen [::]:80;
    server_name cloxinunbeaten.xyz www.cloxinunbeaten.xyz;

    return 301 https://cloxinunbeaten.xyz$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name cloxinunbeaten.xyz www.cloxinunbeaten.xyz;

    root /var/www/html;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/cloxinunbeaten.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cloxinunbeaten.xyz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;
    client_max_body_size 1k;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location ~ /\. { return 404; }

    location = /api/heartbeat {
        limit_req zone=cloxin_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/status {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_no_cache 1;
        add_header Cache-Control "no-store" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    location / {
        limit_req zone=cloxin_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_no_cache 1;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }
}
