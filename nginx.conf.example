server {
    listen 80;
    listen [::]:80;
    server_name cloxinunbeaten.xyz www.cloxinunbeaten.xyz;

    return 301 https://cloxinunbeaten.xyz$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name cloxinunbeaten.xyz www.cloxinunbeaten.xyz;

    root /var/www/html;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/cloxinunbeaten.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cloxinunbeaten.xyz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location = / {
        try_files /index.html =404;
    }

    location / {
        try_files $uri =404;
    }

    location ~ /\. {
        deny all;
    }
}
