server {
    listen 80;
    listen [::]:80;
    server_name cloxinunbeaten.xyz www.cloxinunbeaten.xyz;

    return 301 https://cloxinunbeaten.xyz$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name cloxinunbeaten.xyz www.cloxinunbeaten.xyz;

    root /var/www/html;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/cloxinunbeaten.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cloxinunbeaten.xyz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_no_cache 1;
    }
}
