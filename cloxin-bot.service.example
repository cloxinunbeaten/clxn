[Unit]
Description=Cloxin Discord bot and site status API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/html
EnvironmentFile=/etc/cloxin/cloxin.env
ExecStart=/usr/bin/node /var/www/html/server.js
Restart=always
RestartSec=5
User=www-data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cloxin

[Install]
WantedBy=multi-user.target
